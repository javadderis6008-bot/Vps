{
  "log": {
    "loglevel": "warning"
  },

  "inbounds": [
    {
      "port": 8080,
      "protocol": "vless",
      "settings": {
        "clients": [
          {
            "id": "7f6b1c32-9d4a-4c71-a2f5-8d5f1e7a9c11"
          }
        ],
        "decryption": "none"
      },

      "streamSettings": {
        "network": "ws",
        "wsSettings": {
          "path": "/vpn"
        }
      },

      "sniffing": {
        "enabled": true,
        "destOverride": [
          "http",
          "tls",
          "quic"
        ]
      }
    }
  ],

  "outbounds": [
    {
      "protocol": "freedom",
      "tag": "direct"
    },
    {
      "protocol": "blackhole",
      "tag": "blocked"
    }
  ]
}
